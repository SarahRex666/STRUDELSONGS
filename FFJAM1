const bpc = 4; // beats per cycle (bar in 4/4)
const ws = new WebSocket('ws://localhost:16800');
ws.onmessage = e => {
  const { bpm } = JSON.parse(e.data);
  setcps((bpm / 60) / bpc); // convert BPM -> cycles/sec
};



